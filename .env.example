# ========== SUPABASE (full system database) ==========
# 1) Create project at https://supabase.com
# 2) Run SQL from /supabase/schema.sql in SQL Editor
# 3) Fill keys below from Project Settings → API
# 4) Set STORAGE_MODE=supabase and restart npm run dev
STORAGE_MODE="json"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional public anon key (not required for current server-side setup)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Newsletter sending (storage is Supabase when STORAGE_MODE=supabase)
NEWSLETTER_MODE="demo"
